<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    PromeRotation ACR 开发工作区 · NuGet 源配置

    与 D:\LittleDartACR（卫月插件工作区）不同：这里的引用**全部来自一个 NuGet 包**
    （PromeRotation.SDK.CNGL），不依赖本机是否装了国服卫月、也不依赖 Dalamud.NET.Sdk。

    三层还原保障（从快到慢）：
      1. 本机缓存 %USERPROFILE%\.nuget\packages
         —— 已经还原过一次就能离线编译（开发机已缓存 0.1.0-preview.3）。
            ⚠️ 故意不设置 globalPackagesFolder，否则会绕开这份缓存。
      2. local-fallback（libs\packages）
         —— 离线兜底目录，把 .nupkg 放进去即可。
      3. nuget.org
         —— 联网时正常还原。

    彻底离线时的替代方案：直接引用解包好的引用程序集
        dotnet build -p:UseSdkPackage=false
    见 docs\05-PR开发流程与调试.md。
  -->

  <packageSources>
    <clear />
    <add key="local-fallback" value="libs\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="local-fallback">
      <package pattern="PromeRotation.SDK.CNGL" />
      <package pattern="ECommons" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
